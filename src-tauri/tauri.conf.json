{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BatchSRT",
  "version": "0.1.6",
  "identifier": "com.n.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BatchSRT",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "maximized": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFRUZDQUVCN0U5RTExMEIKUldRTEVaNSs2OHJ2M3FheEpibkN0dlFSazFOZ1YySGlPWTBuRmtwaFBPU0hKSWl6aVVoOFhIRHIK",
      "endpoints": [
        "https://github.com/fanzihui/batchSRT/releases/latest/download/latest.json"
      ]
    }
  }
}
